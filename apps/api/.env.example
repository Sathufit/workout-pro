# ─── Database ─────────────────────────────────────────────────────────────────
# Get this from MongoDB Atlas → your cluster → Connect → Drivers
# Replace <username>, <password>, <cluster> with your actual values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/workoutpro?retryWrites=true&w=majority

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
# Generate strong random strings (min 32 chars each)
# Run this in your terminal to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-random-64-char-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# URL of your frontend (used for CORS)
FRONTEND_URL=http://localhost:3000

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Sign up at resend.com → API Keys → Create API Key
# Leave blank to skip email sending during development
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# ─── Web Push Notifications (optional) ───────────────────────────────────────
# Generate VAPID keys by running: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@yourdomain.com
